{
  "codemender-security-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|.*:run_command|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "./security_gate_hook.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
